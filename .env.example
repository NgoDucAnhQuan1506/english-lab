# These are examples. Set environment variables in Render or PowerShell;
# npm start does not load this file automatically.
PORT=3000
# Optional safe compatibility mode: legacy-v1; default is foundation-v2.
COURSE_EDITION=foundation-v2
NODE_ENV=production
# Recommended on Render: connection string supplied by your PostgreSQL provider.
# Keep TLS verification enabled; use the provider's supported connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Optional: bootstrap admin from the Account screen. Requires BOTH values.
ADMIN_EMAIL=your-private-email@example.com
ADMIN_SETUP_KEY=replace-with-your-own-random-secret-at-least-32-characters
# Alternative to PostgreSQL: mount a persistent disk, then set DATA_DIR.
# DATA_DIR=/var/data/english-lab
